---
import Trianglify from "./Trianglify.astro";
---

<header class="site-header" role="navigation">
  <ul class="site-header__wrapper">
    <li
      class="site-header__home site-header__highlight"
      aria-label="Navigate to the home page"
    >
      <a id="header-home" href="/">
        <Trianglify animate cellSize={8} controlKey="header">Terry Chen</Trianglify>
      </a>

    </li>
    <li class="site-header__spacer"></li>
    <li><a href="/assets/resume.pdf">Resume</a></li>
    {
      /*
      <li><a href="/portfolio">Portfolio</a></li>
      <li><a href="/archive">Blog</a></li>
    */
    }
    <li class="site-header__menu-toggler site-header__highlight">
      <a
        class="menu-button"
        href="#"
        role="button"
        aria-label="Open menu"
        aria-controls="mobile-menu mobile-menu-bg"
        ><span class="menu-blip menu-blip__1"><span></span></span><span
          class="menu-blip menu-blip__2"><span></span></span
        ><span class="menu-blip menu-blip__3"><span></span></span><span
          class="menu-blip menu-blip__4"><span></span></span
        ></a
      >
    </li>
  </ul>
  <div
    class="site-header__menu-background"
    id="mobile-menu-bg"
    aria-hidden="true"
  >
  </div>
  <div
    class="site-header__menu"
    id="mobile-menu"
    role="menu"
    aria-hidden="true"
  >
    <ul class="site-header__menu-wrapper">
      <li><a href="/assets/resume.pdf" tabindex="-1">Resume</a></li>
      {
        /*
        <li><a href="/portfolio" tabindex="-1">Portfolio</a></li>
        <li><a href="/archive" tabindex="-1">Blog</a></li>
      */
      }
    </ul>
  </div>
</header>

<style>
  @import "$styles/variables.css";
  
  :global(.menu-open) {
    overflow: hidden;

    .site-header__home rect {
      --bg-color: var(--color-bg3);
    }
  }

  .site-header {
    height: 3rem;
    font-size: 1.2em;
    z-index: 10;

    &__wrapper {
      display: flex;
      width: 100%;
      height: 3rem;
      justify-content: space-between;
      align-items: center;
      gap: 2em;
      padding-left: 0;

      li {
        display: none;
      }

      .site-header__highlight {
        display: block;
      }
    }

    a {
      color: currentColor;
    }

    &__spacer {
      flex: 1;
    }

    &__about,
    &__portfolio,
    &__resume,
    &__blog,
    &__contact {
      font-weight: 700;
    }

    &__home {
      font-weight: 900;
      font-size: 1.4em;
      line-height: 1;
      z-index: 1;
    }

    &__about {
      color: var(--about-color);
    }

    &__portfolio {
      color: var(--portfolio-color);
    }

    &__resume {
      color: var(--home-color);
    }

    &__blog {
      color: var(--blog-color);
    }

    &__contact {
      color: var(--contact-color);
    }

    &__wrapper:hover li a {
      opacity: 0.7;
    }

    &__wrapper:hover &__highlight a,
    &__wrapper li a:hover {
      opacity: 1;
    }

    @media (--gt-than-tablet) {
      top: -4.7rem;

      &__wrapper li {
        display: block;
      }

      &__wrapper &__menu-toggler {
        display: none;
      }

      &__menu {
        display: none;
      }
    }
  }

  .site-header__menu {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.3s ease;

    &-toggler {
      position: relative;
      width: 2rem;
      height: 2rem;
      z-index: 1;
    }

    &-background {
      position: absolute;
      top: 2.475rem;
      right: 8.4vw;
      width: 5px;
      height: 5px;
      background-color: var(--color-bg3);
      border-radius: 100%;
      transform: scale(0);
      transition: transform 0.3s ease;
    }

    &-wrapper {
      display: flex;
      flex-direction: column;
      justify-content: space-around;
      width: 90%;
      height: calc(100vh - 10rem);
      text-align: center;
      padding-left: 0;
      margin: 5rem auto;

      li {
        display: block;
      }
    }

    .menu-open & {
      opacity: 1;
      pointer-events: all;
    }
  }

  .menu-button {
    display: inline-block;
    width: 100%;
    height: 100%;
  }

  .menu-blip {
    position: absolute;
    width: 0.3rem;
    height: 0.3rem;
    transition: transform var(--tn-fcn);

    span {
      position: absolute;
      width: 100%;
      height: 100%;
      background-color: var(--title-color);
      transform-origin: 0 50%;
      transition: transform var(--tn-fcn);
    }

    &__1 {
      top: 0.4rem;
      left: 0.6rem;
      transform: translate(0.35rem, -0.1rem);

      span {
        transform: rotate(45deg);
      }
    }

    &__2 {
      bottom: 0.4rem;
      left: 0.6rem;
      transform: translate(-0.1rem, -0.35rem);

      span {
        transform: rotate(-45deg);
      }
    }

    &__3 {
      bottom: 0.4rem;
      right: 0.2rem;
      transform: translate(-0.35rem, 0.1rem);

      span {
        transform: rotate(-135deg);
      }
    }

    &__4 {
      top: 0.4rem;
      right: 0.2rem;
      transform: translate(0.1rem, 0.35rem);

      span {
        transform: rotate(135deg);
      }
    }
  }

  .menu-open .menu-blip {
    transform: translate(0, 0);

    &__1 span {
      transform: rotate(45deg) scaleX(2.5);
    }

    &__2 span {
      transform: rotate(-45deg) scaleX(2.5);
    }

    &__3 span {
      transform: rotate(-135deg) scaleX(2.5);
    }

    &__4 span {
      transform: rotate(135deg) scaleX(2.5);
    }
  }
</style>

<script>
  import { $, $$ } from "$lib/utils.ts";

  let bodyClsList = $("body")!.classList,
    menu = $(".site-header__menu")!,
    toggler = $(".site-header__menu-toggler")!;

  toggler.addEventListener("click", (e) => {
    e.preventDefault();

    ($(".site-header__menu-background") as HTMLElement).style.transform = bodyClsList.contains(
      "menu-open",
    )
      ? "scale(0)"
      : `scale(${
          (2 *
            Math.sqrt(
              window.innerHeight * window.innerHeight +
                window.innerWidth * window.innerWidth,
            )) /
          5
        })`;

    if (bodyClsList.contains("menu-open")) {
      // close the menu
      bodyClsList.remove("menu-open");
      $("html")!.classList.remove("menu-open");
      menu.setAttribute("aria-hidden", "true");
      $$(menu, "a").forEach((a) => a.setAttribute("tabindex", "-1"));
      toggler.setAttribute("aria-label", "Open menu");
    } else {
      // open the menu
      bodyClsList.add("menu-open");
      $("html")!.classList.add("menu-open");
      menu.removeAttribute("aria-hidden");
      $$(menu, "a").forEach((a) => a.removeAttribute("tabindex"));
      toggler.setAttribute("aria-label", "Close menu");
    }
  });
</script>
