---
import { getCollection } from "astro:content";
import Page from "$layouts/Page.astro";
import { formatDate } from "$lib/utils";

const posts = (await getCollection("posts")).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
---

<Page title="Post archive">
  {posts.map((post) => ( 
    <h2><a href={`/posts/${post.id}`}><span class="date faded">{formatDate(post.data.date)}</span> <span class="title">{post.data.title}</span></a></h2>
  ))}
  {posts.length === 0 && <em>No posts available.</em>}
</Page>

<style>
  h2 a {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
  }
  .date {
    width: 9.5ch;
    font-size: 0.9em;
  }
  .title {
    flex: 1;
  }
</style>
