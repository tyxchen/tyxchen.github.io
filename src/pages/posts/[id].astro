---
import { getCollection, render } from "astro:content";
import Page from "$layouts/Page.astro";
import PageWithHero from "$layouts/PageWithHero.astro";
import { formatDate } from "$lib/utils";
import { Icon } from "astro-icon/components";

export async function getStaticPaths() {
  const posts = await getCollection("posts");
  return posts.map((post) => ({
    params: { id: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

const Layout = post.data.heroImage ? PageWithHero : Page;
const props = {
  layout: `post${post.data.heroImage ? "-cover" : ""}`,
  title: post.data.title,
  subtitle: post.data.subtitle,
  ...{
    heroImage: post.data.heroImage ?? "",
    heroAttr: post.data.heroAttr,
  },
};
---

<Layout {...props}>
  <Fragment slot="header">
    <p class="post-time">
      <time>{formatDate(post.data.date, "%d %b %Y")}</time> &mdash; {
        Math.ceil((post.body?.split(" ").length ?? 1) / 180)
      } min read
    </p>
  </Fragment>
  <article>
    <Content />
  </article>

  <style>
    @import "$styles/variables.css";

    :global(main) {
      max-width: 800px;
    }

    :global(.layout-post #header) {
      margin-top: 1rem;
      
      @media (--gt-than-tablet) {
        margin-bottom: 2rem;
      }
    }

    :global(.layout-post #title) {
      font-size: 2.5rem;

      @media (--gt-than-tablet) {
        font-size: 3.5rem;
      }
    }

    .post-time {
      font-size: 1rem;
    }
  </style>
</Layout>
