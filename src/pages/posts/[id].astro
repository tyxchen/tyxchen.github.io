---
import { getCollection, render } from "astro:content";
import Page from "$layouts/Page.astro";
import PageWithHero from "$layouts/PageWithHero.astro";
import { formatDate } from "$lib/utils";
import { Icon } from "astro-icon/components";

export async function getStaticPaths() {
  const posts = await getCollection("posts");
  return posts.map((post) => ({
    params: { id: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

const Layout = post.data.heroImage ? PageWithHero : Page;
const props = {
  layout: `post${post.data.heroImage ? "-cover" : ""}`,
  title: post.data.title,
  subtitle: post.data.subtitle,
  ...{
    heroImage: post.data.heroImage ?? "",
    heroAttr: post.data.heroAttr,
  },
};
---

<Layout {...props}>
  <Fragment slot="header">
    <p>
      <time>{formatDate(post.data.date, "%d %b %Y")}</time> &mdash; {
        Math.ceil((post.body?.split(" ").length ?? 1) / 180)
      } min read
    </p>
  </Fragment>
  <article>
    <Content />
  </article>

  <style>
    @import "$styles/variables.css";

    #header {
      line-height: 1.2;
      margin-top: 0rem;
      margin-bottom: 1.5rem;

      @media (--gt-than-tablet) {
        margin-bottom: 3rem;
      }
    }

    #title {
      color: var(--title-color);
      font-size: 4rem;
      font-weight: 900;
      line-height: 1;
      margin: 0;
      transition: color var(--tn-fcn);

      @media (--gt-than-tablet) {
        font-size: 5rem;
      }
    }

    .subtitle {
      color: var(--subtitle-color);
      font-weight: 700;
      margin: 0.1em 0;

      a {
        color: var(--color-fg2);
      }
    }

    :global(.layout-post-cover) {
      #header .cover-image {
        width: 100%;
        height: 30vh;
        background-size: cover;
        background-position: center 80%;

        @media (--gt-than-tablet) {
          height: 70vh;
          background-attachment: scroll, fixed;
        }

        @media print {
          display: none;
        }
      }

      #header .image-attr {
        color: white;
        margin-top: -2em;
        overflow: hidden;

        em {
          display: inline-block;
          opacity: 0.8;
          transform: translateX(calc(100% - 2em));
          transition: var(--tn-fcn);
        }

        em:hover {
          opacity: 1;
          transform: translateX(-1em);
        }
      }

      .container {
        width: 90%;
        max-width: 1136px;
        margin: 0 auto;
      }

      #title {
        margin-top: -0.85em;

        &::first-line {
          color: white;
        }

        @media print {
          margin-top: 0;

          &::first-line {
            color: var(--fg-color);
          }
        }
      }
    }
  </style>
</Layout>
