---
import MetaLayout from "$layouts/MetaLayout.astro";
import Header from "$components/Header.astro";
import ShowMoreLessBtn from "$components/ShowMoreLessBtn.astro";
import Trianglify from "$components/Trianglify.astro";
import { Icon } from "astro-icon/components";

import * as cv from "src/data/cv.json";
import * as publications from "src/data/publications.json";

const extra_employment = cv.employment
  .slice(2)
  .map((_, i) => `employment-${i + 2}`)
  .join(" ");
---

<MetaLayout layout="home" title="Terry Chen">
  <Header />

  <main>
    <header id="header">
      <figure id="header-portrait">
        <img
          src="/assets/images/IMG_2756-compressed.jpeg"
          alt="Terry's profile photo"
        />
      </figure>
      <section id="header-description">
        <h1>
          Hi, I&CloseCurlyQuote;m{" "}
          <Trianglify animate interactive cellSize={16} controlKey="header"
            >Terry</Trianglify
          >.
        </h1>

        <p>
          I&CloseCurlyQuote;m a GPU Dev Tech engineer at AMD, helping developers
          optimize their games for AMD hardware.
        </p>

        <p>
          I&CloseCurlyQuote;m also a master&CloseCurlyQuote;s student under the
          supervision of <a href="https://profs.etsmtl.ca/agruson/"
            >Prof. Adrien Gruson</a
          > and
          <a href="https://cim.mcgill.ca/~derek/">Prof. Derek Nowrouzezahrai</a
          >, researching improvements to real-time rendering algorithms.
        </p>

        <footer id="header-links">
          <!-- <a href="mailto:tyxchen@outlook.com"><Icon name="ph:envelope" /></a> -->
          <!-- <a href="/assets/resume.pdf"><Icon name="ph:read-cv-logo" /></a> -->
          <a rel="noreferrer" href="https://github.com/tyxchen">
            <Icon name="fa7-brands:github" />
            <span>tyxchen</span>
          </a>
          <a
            rel="noreferrer"
            href="https://bsky.app/profile/tyxchen.bsky.social"
          >
            <Icon name="fa7-brands:bluesky" />
            <span>@tyxchen.bsky.social</span>
          </a>
          <a rel="noreferrer" href="https://www.linkedin.com/in/tyxchen">
            <Icon name="fa7-brands:linkedin" />
            <span>Terry Chen</span>
          </a>
        </footer>
      </section>
    </header>

    <div id="qualifications">
      <section>
        <h2>Education</h2>

        <ul class="timeline">
          {
            cv.education.map((item) => (
              <li>
                <strong>{item.institution}</strong>&nbsp;{" "}
                <span class="timeline-location small">{item.location}</span>
                <div class="timeline-date small">
                  {item.date.replace("-", "–")}
                </div>
                {item.description}
              </li>
            ))
          }
        </ul>
      </section>

      <section>
        <h2>Work Experience</h2>

        <ul class="timeline">
          {
            cv.employment.slice(0, 2).map((item, i) => (
              <li>
                <strong>{item.organization}</strong>&nbsp;{" "}
                <span class="timeline-location small">{item.location}</span>
                <div class="timeline-date small">
                  {item.date.replace("-", "–")}
                </div>
                {item.description}
                {i === 1 && cv.employment.length > 2 && (
                  <ShowMoreLessBtn
                    type="more"
                    class="small"
                    ariaControls={extra_employment}
                  />
                )}
              </li>
            ))
          }
          {
            cv.employment.slice(2).map((item, i) => (
              <li id={`employment-${i + 2}`}>
                <strong>{item.organization}</strong>&nbsp;{" "}
                <span class="timeline-location small">{item.location}</span>
                <div class="timeline-date small">
                  {item.date.replace("-", "–")}
                </div>
                {item.description}
                {i === cv.employment.length - 3 && (
                  <ShowMoreLessBtn
                    type="less"
                    class="small"
                    ariaControls={extra_employment}
                  />
                )}
              </li>
            ))
          }
        </ul>
      </section>
    </div>

    <section>
      <h2>Publications</h2>

      {
        publications.papers.toReversed().map((paper) => (
          <article class="publication">
            <aside>
              <img
                src={paper.thumb
                  .replace("$PubDir", `/assets/publications/${paper.id}`)
                  .replace("$ProjDir", paper.id)}
                alt={`Thumbnail for ${paper.title}`}
              />
            </aside>
            <div>
              <h3>{paper.title}</h3>
              <p>
                {paper.authors
                  .map((author, i) => {
                    if (author === "Terry Chen") {
                      return <strong>T. Chen</strong>;
                    } else {
                      const authorNames = author.split(" ");
                      const collaboratorLink =
                        publications.collaborators[
                          author as keyof typeof publications.collaborators
                        ] ?? null;
                      const authorInitialsName = authorNames
                        .map((name, j) =>
                          j === authorNames.length - 1
                            ? ` ${name}`
                            : `${name[0]}.`,
                        )
                        .join("");
                      return collaboratorLink ? (
                        <a href={collaboratorLink}>{authorInitialsName}</a>
                      ) : (
                        authorInitialsName
                      );
                    }
                  })
                  .reduce((prev, curr) => [prev, ", ", curr])}
              </p>
              <p>
                {paper.conference}
                {paper.journal && ` (${paper.journal})`}, {paper.year}
              </p>
              <p>
                {paper.project && <a href={paper.project}>[project]</a>}
                {paper.paper && (
                  <a
                    href={paper.paper.replace(
                      "$PubDir",
                      `/assets/publications/${paper.id}`,
                    )}
                  >
                    [paper]
                  </a>
                )}
              </p>
            </div>
          </article>
        ))
      }
    </section>

    <!--
    <section>
      <h2>Awards</h2>

      <ul>
        <li>NSERC Undergraduate Student Research Award (2023)</li>
        <li>University of Waterloo Undergraduate Research Fellowship (2023)</li>
      </ul>
    </section>
    -->
  </main>
</MetaLayout>

<style>
  @import "$styles/variables.css";

  html {
    @apply --font-accent;
  }
  :global(a) {
    color: var(--trianglify-color);
  }
  main {
    flex: 1;
    font-size: 20px;
  }
  main > section {
    margin: 2.5em 0;
  }
  ul,
  ol {
    padding-left: 1.5em;
  }
  #header {
    display: flex;
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: center;
    gap: 4em;
    line-height: 1.5;
    margin-top: 2rem;
    margin-bottom: 3rem;
  }
  #header-portrait {
    display: flex;
    flex-direction: column;
    justify-content: center;
    width: 480px;
    max-width: 100vw;
    margin: 0;
  }
  #header-description {
    display: flex;
    flex-direction: column;
    flex: 1;
    min-width: 320px;
    gap: 1em;
  }
  #header-description h1 {
    margin: -0.35em 0;
  }
  #header-description p {
    font-size: 1.08em;
    margin: 0;
  }
  #header-links {
    display: flex;
    flex-direction: column;
    flex: 1;
    /* gap: 0.25em; */
    justify-content: end;
    align-items: start;
    font-size: 0.9em;
  }
  #header-links span {
    text-decoration: underline;
  }
  #qualifications {
    display: flex;
    flex-direction: row;
    flex-wrap: wrap;
    row-gap: 0.25em;
    column-gap: 2em;
    margin-bottom: -1em;
  }
  #qualifications section {
    flex: 1;
    min-width: 320px;
  }
  .timeline {
    position: relative;
    list-style: none;
  }
  .timeline::before {
    content: "";
    position: absolute;
    top: 1em;
    bottom: 0.3em;
    left: 0.5em;
    width: 0.2em;
    background: var(--color-fg3);
    opacity: 0.5;
    border-radius: 0.2em;
  }
  .timeline li {
    position: relative;
    margin-bottom: 1em;
  }
  .timeline li::before,
  .timeline li::after {
    content: "";
    position: absolute;
    top: 0.4em;
    left: -1.25em;
    transition: var(--tn-fcn);
  }
  .timeline li::after {
    height: 0.5em;
    width: 0.5em;
    background: var(--bg-color);
    border: 2px solid;
    border-radius: 100%;
  }
  .timeline li:first-child::before {
    height: 0.3em;
    width: 0.3em;
    background: var(--fg-color);
    border-radius: 100%;
    margin: 0.2em;
    z-index: 10;
  }
  .timeline li:first-child::after {
    padding: 0.1em;
    margin: -0.1em;
  }
  .timeline li:last-child::before {
    top: 1em;
    bottom: 0;
    width: 0.5em;
    background: var(--bg-color);
  }
  .timeline-location {
    white-space: nowrap;
  }
  .timeline-date {
    margin: 0.1em 0 0.4em;
  }
  .timeline :global(.show-more),
  .timeline :global(.show-less) {
    text-align: left;
    margin-top: 0.5em;
  }
  .publication {
    display: flex;
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
    gap: 2em;
    font-size: 0.9em;
    margin: 1em 0;
  }
  .publication h3 {
    font-weight: 450;
    margin: 0;
    margin-bottom: 0.2em;
  }
  .publication aside {
    width: 6em;
    height: 6em;
    border: 1px solid var(--color-fg3);
    overflow: hidden;
  }
  .publication img {
    height: 100%;
  }
  .publication > div {
    flex: 1;
    min-width: 320px;
  }
  .publication p {
    margin: 0;
  }
</style>
