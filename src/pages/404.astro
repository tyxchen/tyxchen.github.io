---
import Layout from "$layouts/Layout.astro";
import Button from "$components/Button.astro";
---

<Layout layout="default" title="Page Not Found">
  <h1>404 - Page Not Found</h1>

  <figure>
    <canvas class="art-bg" width="618" height="298" aria-hidden="true"></canvas>
    <svg
      class="art-mask"
      width="620"
      height="300"
      xmlns="http://www.w3.org/2000/svg"
      aria-hidden="true"
    >
      <mask id="404-mask">
        <rect x="0" y="0" width="620" height="300" fill="white"></rect>
        <text x="310" y="260" fill="black" text-anchor="middle">404</text>
      </mask>
      <rect
        class="ooh"
        x="0"
        y="0"
        width="620"
        height="300"
        mask="url(#404-mask)"></rect>
      <text class="ooh" x="310" y="260" text-anchor="middle">404</text>
    </svg>
  </figure>

  <h2>Whoops, looks like this page doesn't exist.</h2>

  <p>
    It might have been moved, or it might not be ready yet. Sorry
    &CloseCurlyQuote;bout that.
  </p>

  <p>
    <Button el="a" foreground="var(--trianglify-color)" href="/">Take me home</Button>
  </p>
</Layout>

<style>
  html,
  body {
    overflow-x: hidden;
  }
  :global(main) {
    position: relative;
    text-align: center;
    margin-top: 40px;
  }
  figure {
    position: relative;
    margin-left: 0;
    margin-right: 0;
  }
  h1 {
    position: absolute;
    top: -1000px;
  }
  .art-mask {
    position: absolute;
    top: 0;
    left: calc(50% - 310px);
    pointer-events: none;
  }
  .art-mask text {
    font: bold 300px sans-serif;
  }
  .art-mask rect.ooh {
    transition: var(--tn-fcn);
    fill: var(--bg-color);
  }
  .art-mask text.ooh {
    stroke-width: 2px;
    stroke: var(--fg-color);
    fill: transparent;
  }
</style>

<script>
  import { hexToRGB, RGBToHex, lerpColour, type Colour } from "$lib/colours";

  const canvas = document.querySelector(".art-bg")! as HTMLCanvasElement,
    ctx = canvas.getContext("2d")!,
    { width, height } = canvas;

  const baseColours = [
    ["#091ede", "#c7e3eb"],
    ["#8cdb4b", "#f2f19d"],
    ["#16450c", "#cc7ecc"],
    ["#f00f04", "#78460a"],
    ["#091ede", "#c7e3eb"],
  ].map(([from, to]) => [hexToRGB(from), hexToRGB(to)] as [Colour, Colour]);

  const dayOfYear = ((date: Date) =>
    (Date.UTC(date.getFullYear(), date.getMonth(), date.getDate()) -
      Date.UTC(date.getFullYear(), 0, 1)) /
    24 /
    60 /
    60 /
    1000)(new Date());

  const offsetDayOfYear = (dayOfYear + 345) % 366; // Offset so that the seasons change at the approximate solstice and equinox dates
  const seasonMidpoints = [
    [0, 0],
    [92, 1],
    [183, 2],
    [275, 3],
    [366, 4],
  ] as const;
  const season1 = seasonMidpoints
    .filter((x) => x[0] <= offsetDayOfYear)
    .at(-1)![1];
  const season2 = seasonMidpoints.filter((x) => x[0] >= offsetDayOfYear)[0][1];

  const colour = [
    lerpColour(
      baseColours[season1][0],
      baseColours[season2][0],
      (offsetDayOfYear - seasonMidpoints[season1][0]) /
        (seasonMidpoints[season2][0] - seasonMidpoints[season1][0]),
    ),
    lerpColour(
      baseColours[season1][1],
      baseColours[season2][1],
      (offsetDayOfYear - seasonMidpoints[season1][0]) /
        (seasonMidpoints[season2][0] - seasonMidpoints[season1][0]),
    ),
  ] as [Colour, Colour];

  let { top, left } = canvas.getBoundingClientRect(),
    mousePos: [number, number, number][] = [];

  window.addEventListener("mousemove", (e) => {
    mousePos.push([e.pageX - left, e.pageY - top, 100]);
  });

  window.addEventListener("resize", (e) => {
    ({ top, left } = canvas.getBoundingClientRect());
  });

  window.addEventListener("touchstart", (e) => {
    e.stopPropagation();
    mousePos.push([e.touches[0].pageX - left, e.touches[0].pageY - top, 100]);
  });

  ctx.clearRect(0, 0, width, height);

  const animate = () => {
    ctx.clearRect(0, 0, width, height);

    while (mousePos.length && mousePos[0][2] <= 0) {
      mousePos.shift();
    }

    for (let i = 0; i < mousePos.length - 1; i++) {
      let posn = mousePos[i];
      ctx.beginPath();
      ctx.lineCap = "round";
      ctx.lineWidth = (Math.sqrt(mousePos[i][2]) / 10) * 32;
      ctx.strokeStyle = `${RGBToHex(lerpColour(colour[1], colour[0], mousePos[i][2] / 100))}`;
      ctx.moveTo(mousePos[i + 1][0], mousePos[i + 1][1]);
      ctx.lineTo(posn[0], posn[1]);
      ctx.stroke();
      ctx.closePath();
      mousePos[i][2] -= 0.75;
    }

    return requestAnimationFrame(animate);
  };

  animate();
</script>
