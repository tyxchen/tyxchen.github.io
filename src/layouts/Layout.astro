---
import Header from "$components/Header.astro";

import "normalize.css";
import "$styles/core.css";

type Props = { layout: string; title: string };

const { layout, title } = Astro.props as Props;
---

<!doctype html>
<html lang="en-ca" class={`no-js no-katex layout-${layout}`}>
  <head>
    <meta charset="utf-8" />
    <meta http-equiv="X-UA-Compatible" content="IE-edge" />
    <!--<meta
      http-equiv="Content-Security-Policy"
      content="default-src 'self';frame-src 'self' youtube-nocookie.com www.youtube-nocookie.com;style-src 'self' 'unsafe-inline' rsms.me cdnjs.jsdelivr.net;script-src 'self' 'unsafe-inline' cdn.jsdelivr.net;font-src rsms.me cdn.jsdelivr.net"
    />-->
    <meta
      name="viewport"
      content="width=device-width,initial-scale=1,shrink-to-fit=no"
    />
    <meta name="referrer" content="no-referrer-when-downgrade" />

    <link rel="shortcut icon" href="/favicon.png?v20181206" type="image/png" />

    <!-- TODO: add seo -->
     <title>{title} | Terry Chen</title>

    <style is:inline>
      html {
        background-color: #fff;
      }
      @media (prefers-color-scheme: dark) {
        html {
          background-color: #050723;
        }
      }
      .site-header,
      main {
        width: 90%;
        max-width: 1136px;
        margin: 0 auto;
      }
      .no-katex [type*="math/tex"] {
        display: inline-block !important;
        font-family: monospace;
        white-space: pre;
      }
      .no-katex [type*="math/tex"][type*="mode=display"] {
        display: block !important;
        width: 100%;
        text-align: center;
      }
    </style>

    <script is:inline>
      document.documentElement.classList.remove("no-js");
    </script>

    <link href="https://rsms.me/inter/inter.css" rel="stylesheet" />

    <slot name="head" />
  </head>
  <body>
    <Header />

    <slot name="preMain" />

    <main>
      <slot />
    </main>

    <footer></footer>

    <slot name="end" />
  </body>

  <style>
    html {
      background-color: var(--bg-color);
      color: var(--fg-color);
      font: 16px/1.5 var(--font-copy);
      -webkit-font-smoothing: antialiased;
      -moz-osx-font-smoothing: grayscale;
      text-rendering: optimizelegibility;
      transition: var(--tn-fcn);
      -ms-touch-action: manipulation;
      touch-action: manipulation;
    }

    body {
      display: flex;
      min-height: 100vh;
      flex-direction: column;

      @media print {
        display: block;
      }
    }

    main {
      flex: 1;
      font-size: 20px;
    }

    footer {
      text-align: center;
      color: var(--color-fg3);
      padding: 2rem 0 1rem;
    }

    figure {
      position: relative;
      margin-left: 0;
      margin-right: 0;

      .img-wrapper {
        position: relative;
        z-index: 1;
        transition-delay: 0.25s;
      }

      .img-background {
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background-color: var(--bg-color);
        opacity: 0;
        pointer-events: none;
        transition: opacity 0.4s ease;
      }

      &.expandable img {
        display: block;
        max-width: 100%;
        transform: scale(1);
        transform-origin: 50% 0;
        transition: transform 0.4s ease;
        cursor: zoom-in;
      }

      &.expanded {
        cursor: zoom-out;
      }

      &.expanded .img-wrapper {
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        z-index: 10;
        transition-delay: 0s;
      }

      &.expanded .img-background {
        opacity: 0.8;
        pointer-events: all;
      }

      &.expanded img {
        position: absolute;
        cursor: zoom-out;
      }

      iframe {
        display: block;
        width: 100%;
        aspect-ratio: 16 / 9;
        margin: 0 auto;
      }

      figcaption {
        font-size: 0.8em;
        font-style: italic;
        text-align: center;
      }
    }
  </style>
</html>
