---
import "normalize.css";
import "$styles/core.css";

type Props = { layout: string; title: string };

import variablesCSS from "../styles/variables.css?raw";
const bgColours = variablesCSS
  .matchAll(/--color-bg1:\s*(#[0-9a-fA-F]+)/g)
  .map((match) => match[1])
  .toArray();
const fgColours = variablesCSS
  .matchAll(/--color-fg1:\s*(#[0-9a-fA-F]+)/g)
  .map((match) => match[1])
  .toArray();
const maxContentWidth = variablesCSS
  .match(/--max-content-width:\s*([^\s;]+)/)![1];

const canonicalUrl = new URL(Astro.url.pathname, Astro.site || Astro.url.origin);

const { layout, title } = Astro.props as Props;
---

<!doctype html>
<html lang="en-ca" class={`no-js no-katex layout-${layout}`}>
  <head>
    <meta charset="utf-8" />
    <meta http-equiv="X-UA-Compatible" content="IE-edge" />
    <meta
      http-equiv="Content-Security-Policy"
      content={[
        "default-src 'self'",
        "frame-src 'self' youtube-nocookie.com www.youtube-nocookie.com",
        "style-src 'self' 'unsafe-inline' rsms.me cdn.jsdelivr.net",
        "script-src 'self' 'unsafe-inline' cdn.jsdelivr.net",
        "font-src rsms.me cdn.jsdelivr.net",
        "img-src 'self' https:",
      ].join(";")}
    />
    <meta
      name="viewport"
      content="width=device-width,initial-scale=1,minimum-scale=1,shrink-to-fit=no"
    />
    <meta name="referrer" content="no-referrer-when-downgrade" />

    <link rel="shortcut icon" href="/favicon.png?v20181206" type="image/png" />

    <title>{title}</title>

    <meta property="og:title" content={title} />
    <meta name="author" content="Terry Chen" />
    <meta property="og:locale" content="en_CA" />
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content="Terry Chen" />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary" />
    <meta property="twitter:title" content={title} />
    <meta
      name="google-site-verification"
      content="CLb9XzC8Rg43i0QoiVfwDKQ0LcAWs6bkkLWilZIVAUs"
    />
    <script
      type="application/ld+json"
      set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@type": "WebSite",
        author: { "@type": "Person", name: "Terry Chen" },
        headline: "Home",
        name: "Terry Chen",
        publisher: {
          "@type": "Organization",
          logo: {
            "@type": "ImageObject",
            url: `${Astro.site}/favicon.png?v20181206`,
          },
          name: "Terry Chen",
        },
        url: Astro.url,
      })}
    />

    <style
      set:html={`
        html {
          background-color: ${bgColours[0]};
          color: ${fgColours[0]};
        }
        @media (prefers-color-scheme: dark) {
          html {
            background-color: ${bgColours[1]};
            color: ${fgColours[1]};
          }
        }
        .site-header,
        main {
          width: 90%;
          max-width: ${maxContentWidth};
          margin: 0 auto;
        }
        .no-katex .katex-html {
          display: none;
        }
      `
        .replace(/\s*([,:;()\{\}])\s*/g, "$1")
        .replaceAll(";}", "}")
      }
    ></style>

    <script is:inline>
      document.documentElement.classList.remove("no-js");
    </script>

    <link href="https://rsms.me/inter/inter.css" rel="stylesheet" />

    <!-- KaTeX fallback when JS is disabled -->
    <noscript class="katex-fallback">
      <link
        rel="stylesheet"
        href="https://cdn.jsdelivr.net/npm/katex@0.16.44/dist/katex.min.css"
        integrity="sha256-PUnv8l7l2UADIBJsGSebmAIqyXYrUn/8KlB17AYsbLw="
        crossorigin="anonymous"
        onload="document.documentElement.classList.remove('no-katex')"
      />
    </noscript>

    <slot name="head" />
  </head>
  <body>
    <slot />
  </body>

  <style>
    @import "$styles/variables.css";

    html {
      @apply --font-copy;

      background-color: var(--bg-color);
      color: var(--fg-color);
      font-size: 16px;
      line-height: 1.5;
      -webkit-font-smoothing: antialiased;
      -moz-osx-font-smoothing: grayscale;
      text-rendering: optimizelegibility;
      transition: background-color var(--tn-fcn), color var(--tn-fcn);
      touch-action: manipulation;
    }

    body {
      display: flex;
      min-height: 100vh;
      flex-direction: column;
    }

    @media print {
      :root {
        --bg-color: white !important;
        --fg-color: black !important;
      }
      body {
        display: block;
      }
    }
  </style>

  <script>
    // Lazy-load KaTeX CSS
    if (document.querySelector(".katex")) {
      document
        .querySelector("head")
        ?.insertAdjacentHTML(
          "beforeend",
          document.querySelector("noscript.katex-fallback")!.textContent,
        );
    }
  </script>
</html>
